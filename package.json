{
  "name": "@ui-kit/ui-kit",
  "version": "1.0.0",
  "type": "module",
  "description": "Generic UI component library built on shadcn/ui + Tailwind CSS",
  "license": "MIT",
  "repository": "https://github.com/example/ui-kit.git",
  "homepage": "https://github.com/example/ui-kit#readme",
  "main": "./dist/ui-kit.umd.cjs",
  "module": "./dist/ui-kit.js",
  "types": "./dist/src/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/ui-kit.js",
      "require": "./dist/ui-kit.umd.cjs"
